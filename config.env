# Database Configuration
DB_TYPE=postgresql
DB_HOST=so_pg
DB_PORT=5432
DB_NAME=so_uchet
DB_USER=so_user
DB_PASSWORD=so_pass

# Connection Pool Settings
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Connection Timeouts
DB_CONNECT_TIMEOUT=10
DB_QUERY_TIMEOUT=60

# Event Store Settings
EVENT_STORE_PARTITION_MONTHS=12
EVENT_STORE_RETENTION_MONTHS=24

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
