# Copy this file to config.host.env before installing host runtime.

# Database Configuration
DB_TYPE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=so_uchet
DB_USER=so_user
DB_PASSWORD=so_pass

# Connection Pool Settings
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Connection Timeouts
DB_CONNECT_TIMEOUT=10
DB_QUERY_TIMEOUT=60

# Event Store Settings
EVENT_STORE_PARTITION_MONTHS=12
EVENT_STORE_RETENTION_MONTHS=24

# Excel Parser
EXCEL_PARSER_CACHE_MODE=cache_only
EXCEL_PARSER_PRECALC_MODE=off
EXCEL_PARSER_PRECALC_TIMEOUT_SEC=120
EXCEL_PARSER_PRECALC_OUTDIR=
EXCEL_PARSER_PRECALC_TTL_DAYS=7

# SMB credentials for scripts/services/fetch_excel_from_smb.py
SMB_USERNAME=
SMB_PASSWORD=
