# =================================
# 🗄️ SPRINT 2.3 DATABASE CONFIGURATION 
# =================================
# Конфигурация для этапа 2: Mock Services Replacement
# Использует SQLite для разработки

# Database type (sqlite for development, postgresql for production)  
DB_TYPE=sqlite

# SQLite Configuration (for development)
DB_SQLITE_DB_PATH=data/service_oper_uchet.sqlite

# PostgreSQL Configuration (for production - готово для будущего)
DB_HOST=192.168.31.5
DB_PORT=5432
DB_NAME=corp
DB_USER=etl
DB_PASSWORD=
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_CONNECT_TIMEOUT=10

# =================================
# 🔐 API SECURITY CONFIGURATION
# =================================

# JWT Settings
SECRET_KEY=sprint-2-3-real-integration-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# =================================
# 🌐 API SERVER CONFIGURATION  
# =================================

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# CORS Settings (for React frontend)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:3000"]

# Environment
ENVIRONMENT=development

# =================================
# 📁 FILE SYSTEM CONFIGURATION
# =================================

# File paths for Excel processing
EXCEL_SOURCE_PATH=data/excel/
EXCEL_BACKUP_PATH=data/backup/
EXCEL_DOWNLOADS_PATH=data/downloads/

# =================================
# 📊 MONITORING & LOGGING
# =================================

# Logging level
LOG_LEVEL=INFO

# Health check settings
HEALTH_CHECK_TIMEOUT=5

# =================================
# ⚙️ SYNC CONFIGURATION  
# =================================

# Sync settings
DEFAULT_SYNC_TYPE=incremental
INCREMENTAL_PERIOD_MONTHS=3
MAX_RETRY_ATTEMPTS=3
BATCH_SIZE=100

# =================================
# 🧪 DEVELOPMENT SETTINGS
# =================================

# Development flags
ENABLE_SQL_ECHO=false
ENABLE_DETAILED_LOGGING=true
CREATE_SAMPLE_DATA=true

# =================================
# 📝 USAGE INSTRUCTIONS
# =================================
# 
# Для использования этой конфигурации:
# 1. Скопируйте этот файл в .env в корне проекта
# 2. Настройте значения под вашу среду
# 3. Убедитесь что директория data/ существует
# 
# Команды для настройки:
# cp sprint_2_3_config.env .env
# mkdir -p data/excel data/backup data/downloads
# 